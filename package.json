{
  "name": "neovim.pi",
  "version": "0.1.0",
  "description": "pi ↔ neovim companion: a public bidirectional protocol with reference pi extension and nvim plugin.",
  "keywords": [
    "pi-package",
    "neovim"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jitsusama/neovim.pi"
  },
  "exports": {
    "./lib": "./lib/index.ts"
  },
  "scripts": {
    "lint": "pnpm lint:ts && pnpm lint:lua",
    "lint:fix": "pnpm lint:ts:fix && pnpm lint:lua:fix",
    "lint:ts": "biome check extensions/ lib/ tests/ts/",
    "lint:ts:fix": "biome check --write extensions/ lib/ tests/ts/",
    "lint:lua": "luacheck lua tests/lua plugin && stylua --check lua tests/lua plugin",
    "lint:lua:fix": "stylua lua tests/lua plugin",
    "helptags": "nvim --headless --noplugin -u NONE -c 'helptags doc' -c 'qa!'",
    "test": "pnpm test:ts && pnpm test:lua",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:ts:coverage": "vitest run --coverage",
    "test:lua": "./scripts/lua-test.sh"
  },
  "pi": {
    "extensions": [
      "./extensions/neovim-pi"
    ]
  },
  "dependencies": {
    "neovim": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@vitest/coverage-v8": "^4.1.6",
    "typebox": "^1.1.38",
    "vitest": "^4.1.6"
  }
}
