{
  "name": "handshake/v0.1.0",
  "description": "Pi attaches and exchanges capabilities. Both peers report v0.1.0 with the documented capability lists.",
  "steps": [
    {
      "from": "pi",
      "to": "nvim",
      "call": {
        "method": "nvim_exec_lua",
        "args": [
          "return require('neovim-pi.handshake').exchange(...)",
          ["0.1.0", ["pi.session.get", "pi.buffer.uri.resolve"]]
        ]
      },
      "expect": {
        "version": "0.1.0",
        "capabilities": {
          "contains": [
            "nvim.buffer.open",
            "nvim.buffer.markStale",
            "nvim.cursor.set",
            "nvim.cursor.get",
            "nvim.cursor.stream",
            "nvim.cursor.selection.get",
            "nvim.file.open",
            "nvim.file.save",
            "nvim.file.reload",
            "nvim.text.getRange",
            "nvim.text.setRange",
            "nvim.window.layout",
            "nvim.window.focus",
            "nvim.window.close",
            "nvim.buffer.list",
            "nvim.buffer.info",
            "nvim.buffer.switch",
            "nvim.buffer.delete",
            "nvim.diff.files",
            "nvim.diff.pending",
            "nvim.diff.off",
            "nvim.extmark.set",
            "nvim.extmark.clear",
            "nvim.status.publish"
          ]
        }
      }
    }
  ]
}
